    newsText: "[\uACBD\uC81C] \"\uBB34\uB514\uC2A4, \uD55C\uAD6D \uC2E0\uC6A9\uB4F1\uAE09
      'Aa2'\uB85C \uC804\uACA9 \uC0C1\uD5A5\u2026 \uC678\uAD6D\uC778 \uC790\uAE08
      3\uC870 '\uC4F8\uC5B4\uB2F4\uAE30'\"  \uAD6D\uC81C \uC2E0\uC6A9\uD3C9\uAC00\uC0AC
      \uBB34\uB514\uC2A4\uAC00 \uD55C\uAD6D\uC758 \uAD6D\uAC00 \uC2E0\uC6A9\uB4F1\uAE09\uC744
      \uAE30\uC874 'Aa3'\uC5D0\uC11C  'Aa2'\uB85C \uD55C \uB2E8\uACC4 \uC0C1\uD5A5
      \uC870\uC815\uD588\uC2B5\uB2C8\uB2E4. \uC7AC\uC815 \uAC74\uC804\uC131\uACFC
      \uBC18\uB3C4\uCCB4\xB7\uBC29\uC0B0 \uC218\uCD9C  \uD638\uC870\uAC00 \uC8FC\uC694
      \uBC30\uACBD\uC73C\uB85C \uAF3D\uD614\uC2B5\uB2C8\uB2E4. \uB4F1\uAE09 \uBC1C\uD45C
      \uC9C1\uD6C4 \uC678\uAD6D\uC778 \uD22C\uC790\uC790\uB4E4\uC774  \uCF54\uC2A4\uD53C\uC5D0\uC11C
      3\uC870 2\uCC9C\uC5B5 \uC6D0\uC5B4\uCE58\uB97C \uC21C\uB9E4\uC218\uD558\uBA70
      \uC9C0\uC218\uAC00 \uC5F0\uC911 \uCD5C\uACE0\uCE58\uB97C \uACBD\uC2E0\uD588\uC2B5\uB2C8\uB2E4."
