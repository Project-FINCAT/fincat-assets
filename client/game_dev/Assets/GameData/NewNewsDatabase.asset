    newsText: "[\uAE00\uB85C\uBC8C] \"IMF '\uC138\uACC4 \uACBD\uAE30 \uCE68\uCCB4
      \uD655\uB960 40%'\u2026 \uC8FC\uC694\uAD6D \uC81C\uC870\uC5C5 \uC9C0\uC218
      \uB3D9\uBC18 \uCD94\uB77D\"\n\uAD6D\uC81C\uD1B5\uD654\uAE30\uAE08(IMF)\uC774
      \uBC18\uAE30 \uACBD\uC81C\uC804\uB9DD \uBCF4\uACE0\uC11C\uC5D0\uC11C \uAE00\uB85C\uBC8C
