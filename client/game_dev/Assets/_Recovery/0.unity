--- !u!114 &1755455284
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1755455282}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 58b9776ff7802db4cadf6fdad06a7cb2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FIGameManager
  testPanel: {fileID: 183082279}
  q2_3_Panel: {fileID: 1944159360}
  questions:
  - situation: "\uC774\uBC88 \uB2EC \uCE74\uB4DC \uBA85\uC138\uC11C\uAC00 \uC654\uC5B4.
      \uB300\uCDA9 30\uB9CC \uC6D0 \uC4F4 \uAC83 \uAC19\uC740\uB370 \uC2E4\uC81C\uB85C\uB294
      47\uB9CC \uC6D0\uC774 \uCCAD\uAD6C\uB410\uC5B4. \uC138 \uAC00\uC9C0 \uACB0\uC81C
      \uC571\uC5D0 \uCE74\uB4DC\uAE4C\uC9C0 \uC368\uC11C \uC5B4\uB514\uC11C \uC0C8\uB294\uC9C0
      \uAC10\uB3C4 \uC548 \uC7A1\uD600."
    optionA: "\uBA85\uC138\uC11C\uB97C \uD56D\uBAA9\uBCC4\uB85C \uBD84\uB958\uD574\uC11C
      \uC5B4\uB514\uC11C \uB9CE\uC774 \uC37C\uB294\uC9C0 \uC815\uD655\uD788 \uD30C\uC545\uD574."
    optionB: "\uB9CE\uC774 \uB098\uC654\uB124 \uD558\uACE0 \uB2E4\uC74C \uB2EC\uC5D4
      \uC880 \uC904\uC5EC\uC57C\uC9C0 \uC0DD\uAC01\uD574."
    optionC: "\uD1B5\uC7A5\uC5D0 \uB3C8\uB9CC \uC788\uC73C\uBA74 \uB410\uC9C0, \uC5B4\uB514
      \uC37C\uB294\uC9C0\uAE4C\uC9C0 \uC54C\uC544\uC57C\uD574?"
    category: 0
  - situation: "\uCE5C\uAD6C\uAC00 \"\uC624\uB298\uB9CC 30% \uD560\uC778! \uB0B4\uC77C\uC774\uBA74
      \uAC00\uACA9 \uC62C\uB77C\"\uB77C\uACE0 \uB9C1\uD06C\uB97C \uBCF4\uB0C8\uC5B4.
      \uAC16\uACE0 \uC2F6\uB358 \uAC70\uAE34 \uD55C\uB370 \uC9C0\uAE08 \uC0AC\uBA74
      \uC774\uBC88 \uB2EC \uC608\uC0B0\uC758 \uC808\uBC18\uC774 \uB0A0\uC544\uAC00."
    optionA: "\uC77C\uB2E8 \uC7A5\uBC14\uAD6C\uB2C8\uC5D0 \uB2F4\uC544\uB450\uACE0
      \uD558\uB8E8 \uC9C0\uB098\uB3C4 \uC0AC\uACE0 \uC2F6\uC73C\uBA74 \uADF8\uB54C
      \uACB0\uC81C\uD574."
    optionB: "\uD560\uC778\uC774\uB2C8\uAE4C \uC774\uB4DD \uC544\uB2C8\uC57C? \uAD6C\uB9E4\uD574\uC57C\uACA0\uC5B4."
    optionC: "\uC9C0\uAE08 \uC0AC\uC57C \uD574. \uB0B4\uC77C\uC774\uBA74 \uB291\uC5B4."
    category: 1
  - situation: "\uD559\uC790\uAE08\uB300\uCD9C \uC720\uC608 \uBB38\uC790\uAC00 \uC654\uC5B4.
      \uC6D0\uAE08 1,200\uB9CC \uC6D0\uC774\uB77C\uB294\uB370 \uC774\uC790\uAC00
      \uC5BC\uB9C8\uC778\uC9C0, \uC5B8\uC81C\uBD80\uD130 \uAC1A\uC544\uC57C \uD558\uB294\uC9C0
      \uC81C\uB300\uB85C \uBCF8 \uC801\uC774 \uC5C6\uC5B4."
    optionA: "\uC774\uC790 \uACC4\uC0B0\uD574\uBCF4\uACE0 \uC878\uC5C5 \uD6C4 \uC0C1\uD658
      \uACC4\uD68D \uBBF8\uB9AC \uC138\uC6CC."
    optionB: "\uC878\uC5C5 \uD6C4\uC5D0 \uC0DD\uAC01\uD560 \uAC70\uC57C. \uC9C0\uAE08\uC740
      \uC5B4\uCC28\uD53C \uC548 \uAC1A\uC544\uB3C4 \uB418\uC796\uC544."
    optionC: "\uBB38\uC790 \uB2EB\uACE0 \uC78A\uC5B4\uBC84\uB824. \uADC0\uCC2E\uC544"
    category: 2
  - situation: "\uB178\uD2B8\uBD81\uC774 \uAC11\uC790\uAE30 \uACE0\uC7A5\uB0AC\uC5B4.
      \uC218\uB9AC\uBE44 35\uB9CC \uC6D0. \uB0B4\uC77C \uACFC\uC81C \uC81C\uCD9C\uC778\uB370
      \uAE09\uD574. \uADFC\uB370 \uD1B5\uC7A5\uC5D4 \uC774\uBC88 \uB2EC \uB0A8\uC740
      \uB3C8 15\uB9CC \uC6D0\uBC16\uC5D0 \uC5C6\uC5B4."
    optionA: "\uBE44\uC0C1\uAE08 \uD1B5\uC7A5\uC5D0\uC11C \uAEBC\uB0B4. \uC774\uB7F0
      \uC0C1\uD669\uC744 \uC704\uD574 \uB530\uB85C \uBAA8\uC544\uB480\uC5B4."
    optionB: "\uC2E0\uC6A9\uCE74\uB4DC \uD560\uBD80\uB85C \uC77C\uB2E8 \uD574\uACB0\uD558\uACE0
      \uB2E4\uC74C \uB2EC \uAC1A\uC544."
    optionC: "\uBD80\uBAA8\uB2D8 \uC6A9\uB3C8 \uCE74\uB4DC \uC368. \uB098\uC911\uC5D0
      \uAC1A\uC73C\uBA74 \uB418\uC9C0."
    category: 3
  - situation: "\uCE5C\uAD6C\uB4E4\uC774 \uC0AC\uD68C \uCD08\uB144\uC0DD \uB54C \uB3C8
      \uBABB \uBAA8\uC740 \uAC8C \uC81C\uC77C \uD6C4\uD68C\uB41C\uB2E4\uACE0 \uD574.
      \uADFC\uB370 \uB9C9\uC0C1 \uBAA9\uD45C\uB97C \uC138\uC6B0\uB824\uB2C8 \uBB50\uBD80\uD130
      \uD574\uC57C \uD560\uC9C0 \uBAA8\uB974\uACA0\uC5B4."
    optionA: "\"1\uB144 \uC548\uC5D0 \uBE44\uC0C1\uAE08 300\uB9CC \uC6D0 \uB9C8\uB828,
      \uB9E4\uB2EC 25\uB9CC \uC6D0 \uC800\uCD95\" \uC774\uB807\uAC8C \uAD6C\uCCB4\uC801\uC73C\uB85C
      \uC368."
    optionB: "\"\uB3C8 \uC880 \uBAA8\uC544\uC57C\uC9C0\" \uD558\uACE0 \uC0DD\uAC01\uC740
      \uD558\uB294\uB370 \uAD6C\uCCB4\uC801\uC73C\uB85C \uC815\uD558\uC9C4 \uC54A\uC544."
    optionC: "\uBAA9\uD45C \uC138\uC6CC\uBD24\uC790 \uC9C0\uCF1C\uC9C0\uC9C0\uB3C4
      \uC54A\uC544. \uADF8\uB0E5 \uD758\uB7EC\uAC00\uB294 \uB300\uB85C."
    category: 4
  - situation: "\uB9E4\uC77C \uB9C8\uC2DC\uB294 \uD3B8\uC758\uC810 \uC544\uBA54\uB9AC\uCE74\uB178
      1,800\uC6D0. \uD55C \uB2EC\uC5D0 \uC5BC\uB9C8 \uC4F0\uB294\uC9C0 \uACC4\uC0B0\uD574\uBCF8
      \uC801 \uC5C6\uC5B4. \uADF8\uB0E5 \uC18C\uC561\uC774\uB77C \uC2E0\uACBD \uC548
      \uC37C\uB294\uB370 \uCE5C\uAD6C\uAC00 \"\uADF8\uAC70 \uC5F0\uAC04 65\uB9CC
      \uC6D0\uC774\uC57C\"\uB77C\uACE0 \uC54C\uB824\uC92C\uC5B4."
    optionA: "\uC9C4\uC9DC\uB85C \uB0B4 \uC18C\uC561 \uC9C0\uCD9C\uB4E4\uC744 \uB2E4
      \uACC4\uC0B0\uD574\uBD10. \uC5B4\uB514\uC11C \uC0C8\uB294\uC9C0 \uD30C\uC545\uD574\uC57C\uACA0\uC5B4."
    optionB: "\uC54C\uBA74\uC11C\uB3C4 \uCEE4\uD53C\uB294 \uD3EC\uAE30 \uBABB \uD574.
      \uADF8\uB0E5 \uB2E4\uB978 \uB370\uC11C \uC904\uC774\uBA74 \uB418\uC9C0."
    optionC: "\uC544 \uADF8\uB798? \uADF8\uB0E5 \uB118\uACA8. \uCEE4\uD53C \uC5C6\uC73C\uBA74
      \uBABB \uC0B4\uC544."
    category: 0
  - situation: "\uC778\uAC8C\uC784 \uC544\uC774\uD15C \uD560\uC778 \uC774\uBCA4\uD2B8.
      \uD3C9\uC18C\uC5D4 3\uB9CC \uC6D0\uC778\uB370 \uC624\uB298\uB9CC 1\uB9CC 5\uCC9C
      \uC6D0. \uC774\uBC88 \uB2EC \uC5EC\uC720 \uC608\uC0B0\uC774 2\uB9CC \uC6D0\uBC16\uC5D0
      \uB0A8\uC9C0 \uC54A\uC558\uC5B4."
    optionA: "\uC608\uC0B0\uC774 \uBD80\uC871\uD558\uB2C8\uAE4C \uD328\uC2A4. \uB2E4\uC74C
      \uB2EC \uC608\uC0B0\uC5D0 \uBBF8\uB9AC \uBC18\uC601\uD574\uB46C."
    optionB: "1\uB9CC 5\uCC9C\uC6D0\uC740 \uC18C\uC561\uC774\uB2C8\uAE4C \uADF8\uB0E5
      \uAE01\uC5B4. \uC5B4\uB5BB\uAC8C \uB418\uACA0\uC9C0."
    optionC: "\uC608\uC0B0 \uCD08\uACFC? \uB9C8\uC774\uB108\uC2A4 \uD1B5\uC7A5\uC5D0\uC11C
      \uAEBC\uB0B4."
    category: 1
  - situation: "\uCE74\uB4DC \uACB0\uC81C \uBB38\uC790\uAC00 \uC654\uB294\uB370 \uB0B4\uAC00
      \uACB0\uC81C\uD55C \uC801 \uC5C6\uB294 3\uB9CC \uC6D0 \uC774\uC6A9 \uB0B4\uC5ED\uC774
      \uC788\uC5B4. \uBA85\uC138\uC11C \uD655\uC778\uC744 \uC798 \uC548 \uD574\uC11C
      \uC9C0\uB09C\uB2EC\uC5D0\uB3C4 \uC774\uB7F0 \uC801 \uC788\uB294 \uAC83 \uAC19\uC544."
    optionA: "\uBC14\uB85C \uCE74\uB4DC\uC0AC\uC5D0 \uC774\uC758\uC2E0\uCCAD\uD558\uACE0,
      \uC55E\uC73C\uB85C \uBA85\uC138\uC11C \uC6D4 1\uD68C \uD655\uC778 \uB8E8\uD2F4
      \uB9CC\uB4E4\uC5B4."
    optionB: "3\uB9CC \uC6D0\uC774\uB2C8\uAE4C \uADF8\uB0E5 \uB118\uC5B4\uAC00. \uADC0\uCC2E\uC544."
    optionC: "\uCE74\uB4DC \uD574\uC9C0\uD558\uBA74 \uB418\uC9C0 \uBB50. \uC0C8\uB85C
      \uB9CC\uB4E4\uC5B4."
    category: 2
  - situation: "\uAC11\uC790\uAE30 \uC544\uD30C\uC11C \uBCD1\uC6D0\uC5D0 \uAC14\uB354\uB2C8
      \uCE58\uB8CC\uBE44\uAC00 20\uB9CC \uC6D0 \uB098\uC654\uC5B4. \uBE44\uC0C1\uAE08\uC774
      \uC5C6\uC5B4\uC11C \uC774\uBC88 \uB2EC \uC2DD\uBE44\uB97C \uD655 \uC904\uC5EC\uC57C
      \uD560 \uAC83 \uAC19\uC544."
    optionA: "\uC6D4\uAE09\uB0A0\uB9C8\uB2E4 \uC790\uB3D9\uC774\uCCB4\uB85C \uBE44\uC0C1\uAE08
      \uACC4\uC88C\uC5D0 \uC77C\uC815 \uAE08\uC561\uC529 \uB123\uAE30 \uC2DC\uC791\uD574."
    optionB: "\uB2E4\uC74C \uB2EC\uC5D4 \uC880 \uB354 \uC544\uAEF4\uC57C\uACA0\uB2E4\uACE0
      \uC0DD\uAC01\uD574."
    optionC: "\uC774\uB7F0 \uC77C\uC774 \uB610 \uC0DD\uAE30\uBA74 \uADF8\uB54C \uAC00\uC11C
      \uC0DD\uAC01\uD560\uAC8C."
    category: 3
  - situation: "\uC774\uBC88 \uB2EC \uC544\uB974\uBC14\uC774\uD2B8\uBE44\uAC00 \uB4E4\uC5B4\uC654\uC5B4.
      \uACE0\uC815\uC9C0\uCD9C \uBE7C\uACE0 \uB0A8\uC740 \uB3C8\uC774 30\uB9CC \uC6D0\uC774\uC57C.
      \uCE5C\uAD6C\uB294 \uC5EC\uD589 \uAC00\uC790\uACE0 \uD558\uACE0, \uB098\uB294
      \uC790\uACA9\uC99D \uC900\uBE44\uB3C4 \uD558\uACE0 \uC2F6\uC5B4."
    optionA: "\uBBF8\uB9AC \uC138\uC6B4 \uC6B0\uC120\uC21C\uC704(\uBE44\uC0C1\uAE08,
      \uC790\uACA9\uC99D, \uC5EC\uD589)\uC5D0 \uB9DE\uAC8C \uB098\uB220. \uC608:
      15\uB9CC/10\uB9CC/5\uB9CC"
    optionB: "\uC77C\uB2E8 \uC5EC\uD589 \uAC00\uACE0 \uC790\uACA9\uC99D\uC740 \uB2E4\uC74C
      \uB2EC\uC5D0 \uC0DD\uAC01\uD574"
    optionC: "\uADF8\uB0E5 \uB2E4 \uC368. \uC5B4\uCC28\uD53C \uB2E4\uC74C \uB2EC\uC5D0
      \uB610 \uBC8C\uC796\uC544."
    category: 4
  result:
