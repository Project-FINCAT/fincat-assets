  m_Script: {fileID: 11500000, guid: 8a58d61627fb7c442819e2ab4bda7bbc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OXManager
  questionText: {fileID: 2136899941}
  resultHeaderText: {fileID: 2075312726}
  explanationText: {fileID: 1731391846}
  nextButtonText: {fileID: 644963759}
  progressSlider: {fileID: 1151009016}
  oButton: {fileID: 1789688745}
  xButton: {fileID: 2053648351}
