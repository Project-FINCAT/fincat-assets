  questions:
  - question: "\uB098\uC774"
    answers:
    - text: "19\uC138 \uC774\uD558"
      score: 1
    - text: "20\uC138 ~ 40\uC138"
      score: 3
  - question: "\uD22C\uC790 \uACBD\uD5D8"
    answers:
    - text: "\uC740\uD589 \uC608\uAE08\xB7\uC801\uAE08\uB9CC \uD574\uBD24\uC5B4\uC694"
      score: 1
    - text: "\uCC44\uAD8C\uC774\uB098 \uC6D0\uAE08\uBCF4\uC7A5 ELS \uC815\uB3C4\uB294
        \uC54C\uC544\uC694"
      score: 2
    - text: "\uD380\uB4DC\uB098 \uC6D0\uAE08 \uC77C\uBD80 \uC190\uC2E4 \uAC00\uB2A5\uD55C
        \uC0C1\uD488\uB3C4 \uD574\uBD24\uC5B4\uC694"
      score: 3
    - text: "\uC8FC\uC2DD \uC9C1\uC811 \uD22C\uC790\uB97C \uD574\uBD24\uC5B4\uC694"
      score: 4
    - text: "\uC120\uBB3C\xB7\uC635\uC158 \uAC19\uC740 \uD30C\uC0DD\uC0C1\uD488\uB3C4
        \uC54C\uC544\uC694"
      score: 5
  - question: "\uAE08\uC735 \uC9C0\uC2DD"
    answers:
    - text: "\uD22C\uC790? \uC798 \uBAB0\uB77C\uC11C \uC544\uC9C1 \uC548 \uD574\uBD24\uC5B4\uC694"
      score: 1
    - text: "\uC8FC\uC2DD\uC774\uB791 \uC801\uAE08 \uCC28\uC774 \uC815\uB3C4\uB294
        \uC54C\uC544\uC694"
      score: 2
    - text: "\uB2E4\uC591\uD55C \uC0C1\uD488\uC744 \uBE44\uAD50\uD574\uC11C \uACE0\uB97C
        \uC218 \uC788\uC5B4\uC694"
      score: 3
    - text: "\uD22C\uC790 \uC804\uB7B5\uC744 \uC2A4\uC2A4\uB85C \uC138\uC6B8 \uC218
        \uC788\uC5B4\uC694"
      score: 4
  - question: "\uD22C\uC790 \uBAA9\uC801"
    answers:
    - text: "\uC6D0\uAE08\uC740 \uC808\uB300 \uC783\uC73C\uBA74 \uC548 \uB3FC\uC694"
      score: 1
    - text: "\uC608\uAE08\uBCF4\uB2E4 \uC880 \uB354 \uBC1B\uACE0 \uC2F6\uC5B4\uC694"
      score: 2
    - text: "\uC911\uAC04 \uC815\uB3C4 \uC704\uD5D8\uC740 \uAC10\uC218\uD560 \uC218
        \uC788\uC5B4\uC694"
      score: 3
    - text: "\uB9CE\uC774 \uBC8C\uACE0 \uC2F6\uC5B4\uC694. \uC190\uC2E4 \uAC10\uC218
        \uAC00\uB2A5"
      score: 4
    - text: "\uCD5C\uB300\uD55C \uB9CE\uC774 \uBC8C\uACE0 \uC2F6\uC5B4\uC694"
      score: 5
  - question: "\uD22C\uC790 \uAE30\uAC04"
    answers:
    - text: "6\uAC1C\uC6D4 \uC548\uC5D0 \uC4F8 \uAC83 \uAC19\uC544\uC694"
      score: 1
    - text: "6\uAC1C\uC6D4 ~ 1\uB144"
      score: 2
    - text: "1\uB144 ~ 2\uB144 "
      score: 3
    - text: "2\uB144 ~ 3\uB144"
      score: 4
    - text: "3\uB144 \uC774\uC0C1"
      score: 5
  - question: " \uC190\uC2E4 \uBC18\uC751 \u2014 \uD22C\uC790\uD55C \uB3C8\uC774
      \uAC11\uC790\uAE30 20% \uC904\uC5C8\uC744 \uB54C"
    answers:
    - text: "\uBC14\uB85C \uB2E4 \uD314\uACA0\uC5B4\uC694"
      score: 1
    - text: "\uC808\uBC18\uB9CC \uD314\uACE0 \uB098\uBA38\uC9C0\uB294 \uAE30\uB2E4\uB824\uBCFC\uAC8C\uC694"
      score: 2
    - text: "\uADF8\uB0E5 \uAE30\uB2E4\uB824\uBCFC\uAC8C\uC694"
      score: 3
    - text: "\uC624\uD788\uB824 \uB354 \uC0B4 \uAE30\uD68C \uC544\uB2D0\uAE4C\uC694?"
      score: 4
  - question: "\uD22C\uC790 \uAC00\uB2A5 \uC790\uC0B0 \uBE44\uC911"
