  correctColor: {r: 0, g: 1, b: 0, a: 1}
  wrongColor: {r: 1, g: 0, b: 0, a: 1}
  defaultColor: {r: 1, g: 1, b: 1, a: 1}
  questions:
  - questionText: "\uC2E0\uC6A9\uC810\uC218\uB97C \uC870\uD68C\uD558\uBA74 \uC2E0\uC6A9\uC810\uC218\uAC00
      \uB5A8\uC5B4\uC9C4\uB2E4."
    answer: 0
    explanation: "\uACFC\uAC70\uC5D0\uB294 \uC2E0\uC6A9\uC810\uC218\uB97C \uC870\uD68C\uD558\uBA74
      \uC810\uC218\uAC00 \uB5A8\uC5B4\uC84C\uC5B4\uC694!\n\uD558\uC9C0\uB9CC 2021\uB144\uB3C4
      \uC774\uD6C4\uBCF8\uC778\uC774 \uC2E0\uC6A9\uC810\uC218\uB97C \uC870\uD68C\uD574\uB3C4
      \uC810\uC218\uC5D0\uB294 \uC544\uBB34 \uC601\uD5A5\uC774 \uC5C6\uC5B4\uC694."
  - questionText: "\uC5F0\uCCB4 \uAE08\uC561\uC744 \uAC1A\uC73C\uBA74 \uC2E0\uC6A9\uC810\uC218\uB294
      \uBC14\uB85C \uC6D0\uB798\uB300\uB85C \uD68C\uBCF5\uB41C\uB2E4."
    answer: 0
    explanation: "\uC5F0\uCCB4 \uB300\uAE08\uC744 \uC0C1\uD658\uD574\uB3C4 \uBC14\uB85C
      \uBC18\uC601\uB418\uC9C0\uB294 \uC54A\uC544\uC694.\n\uC5F0\uCCB4 \uAE30\uB85D\uC740
      \uC77C\uC815 \uAE30\uAC04(\uCD5C\uB300 5\uB144) \uB3D9\uC548 \uB0A8\uC744 \uC218
      \uC788\uC5B4\uC694."
  - questionText: "\uC2E0\uC6A9\uCE74\uB4DC\uC640 \uB300\uCD9C\uC744 \uC131\uC2E4\uD558\uAC8C
      \uC0C1\uD658\uD558\uBA74 \uC2E0\uC6A9\uC810\uC218\uC5D0 \uAE0D\uC815\uC801\uC778
      \uC601\uD5A5\uC744 \uC900\uB2E4."
    answer: 1
    explanation: "\uC2E0\uC6A9\uCE74\uB4DC\uC640 \uB300\uCD9C\uC744 \uC131\uC2E4\uD558\uAC8C
      \uC0C1\uD658\uD558\uBA74 \uC2E0\uC6A9\uC810\uC218\uC5D0 \uAE0D\uC815\uC801\uC778
      \uC601\uD5A5\uC744 \uC918\uC694!"
  - questionText: "\uC2E0\uC6A9\uCE74\uB4DC\uB97C \uB9CE\uC774 \uAC00\uC9C0\uACE0
      \uC788\uC73C\uBA74 \uC2E0\uC6A9\uC810\uC218\uAC00 \uB0AE\uC544\uC9C4\uB2E4."
    answer: 0
    explanation: "\uC2E0\uC6A9\uCE74\uB4DC\uC758 \uAC1C\uC218\uAC00 \uC2E0\uC6A9\uC810\uC218\uC5D0
      \uC601\uD5A5\uC744 \uC8FC\uC9C0\uB294 \uC54A\uC544\uC694. \n\uD558\uC9C0\uB9CC
      \uB2E8\uAE30\uAC04\uC5D0 \uC5EC\uB7EC\uC7A5\uC744 \uBC1C\uAE09\uBC1B\uC73C\uBA74
      \uC2E0\uC6A9\uC810\uC218\uC5D0 \uC601\uD5A5\uC744 \uBBF8\uCE60 \uC218 \uC788\uC73C\uB2C8
      \uC8FC\uC758!"
  - questionText: "\uD734\uB300\uD3F0 \uD560\uBD80\uAE08\uC744 \uC5F0\uCCB4\uD558\uBA74
      \uC2E0\uC6A9\uC810\uC218\uC5D0 \uC601\uD5A5\uC744 \uC904 \uC218 \uC788\uB2E4."
    answer: 1
    explanation: "\uC5F0\uCCB4\uB294 \uC2E0\uC6A9\uC810\uC218 \uD558\uB77D\uC758
      \uC8FC\uC694 \uC6D0\uC778\uC774\uC5D0\uC694.\n\uD734\uB300\uD3F0\uC758 \uACBD\uC6B0,
      \uB2E8\uB9D0\uAE30 \uD560\uBD80\uB300\uAE08\uC744 \uC5F0\uCCB4\uD558\uBA74
      \uC2E0\uC6A9\uD3C9\uAC00 \uC2DC \uBD88\uC774\uC775\uC744 \uBC1B\uC744 \uC218
      \uC788\uC5B4\uC694."
